+// FIX-RETRO-01 — نشانگر ارزیابی: هر کندل فقط یک بار، با حد ضررِ «همان لحظه»، بررسی شود.
+// باگ قبلی: هر دور پایش همهٔ کندل‌های پس از ورود را از اول با حد ضررِ «فعلی» (که شاید بعداً به سربه‌سر/تریلینگ ارتقا یافته)
+// دوباره بررسی می‌کرد؛ پس سطحی که بعداً تعیین شده بود روی کندل‌های گذشته اعمال می‌شد (اعمال عطف‌به‌ماسبق).
+// اصل ثابت: READ ONLY | PAPER ONLY | NO LIVE ORDERS
+
+export interface CursorFields {
+  evalCursorMs?: number | null;
+  lastCheck: number | null;
+}
+
+/** نقطهٔ شروع ارزیابی این دور. کندل‌هایی با زمان بسته‌شدن ≤ این مقدار قبلاً ارزیابی شده‌اند و رد می‌شوند.
+ *  معاملهٔ باز قدیمی بدون نشانگر: هر کندلی که تا lastCheck بسته شده بود، در همان دور ارزیابی شده است. */
+export function evalCursorStart(t: CursorFields, intervalMs: number): number | null {
+  if (typeof t.evalCursorMs === "number") return t.evalCursorMs;
+  if (typeof t.lastCheck === "number") return Math.floor(t.lastCheck / intervalMs) * intervalMs;
+  return null;
+}
